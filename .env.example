# Keep the actual value only in .env.local. Never use a VITE_ prefix for this key.
DEEPSEEK_API_KEY=
# 图片生成服务（vLLM 代理的 gpt-image-2，端点见 worker/deepseek.js）
ARK_API_KEY=

# 注：教师注册邀请码（AIQUOS_TEACHER_INVITE_CODE）已按产品要求移除（2026-10-03），
# 教师端注册不再需要邀请码，服务端忽略该字段；此处保留说明以免旧文档误导。

# 生产 Node 服务必须挂载可持久保存的可写目录；首次启动导入初始班级。
AIQUOS_DATA_DIR=
