node_modules/
dist/
.DS_Store
.openai/
.workbuddy/
*.log
.env
.env.*
!.env.example

# Editor autosave leftovers (copies of CaseArchive.jsx) — not source.
src/XX*
# Admin-published bank overrides, one per edition (精选 / 全量).
worker/bank-overrides.json
worker/bank-overrides-full.json

# 注册账号库（含密码哈希与令牌签名密钥）与师生共享数据（runs/assignments）。
# 与 bank-overrides 同一模式：本地状态，不入库。
worker/auth-accounts.json
worker/aiquos-shared-data.json

# QA screenshots and review captures produced while iterating on the UI.
# Regenerated on demand by scripts/shots.mjs and the qa-*.mjs harnesses;
# 100 MB+ of PNGs should not enter history.
# 用 work/* 而非 work/：目录本身不被排除，下方的 work/kb 白名单才能生效。
work/*

# 本地实验工作区：截图、QA 素材、温度实验的原始数据（数百 MB）
# 只排除重资产，保留轻量的结论文档与脚本便于复现。
work/**/results/
work/**/samples/
work/**/figures/
work/temperature-study/assets/

# 知识库管线（2026-11-12）：脚本与进度账本入库，五层数据目录（raw/cleaned/
# tagged/verified/rejected，数万条候选 JSONL 与采集日志）留在本地。
!work/kb/
work/kb/**
!work/kb/*.mjs
!work/kb/*.sh
!work/kb/PROGRESS.md
!work/kb/audit-sample.md
coverage/
